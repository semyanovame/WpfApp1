<Window x:Class="WpfApp1.WindowEditing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="WindowEditing" Height="450" Width="450">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Наименование:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5"/>
        <Label Content="Артикул:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="TxtPrice" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5"/>
        <Label Content="Описание:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5"/>
        <Label Content="Производитель:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Name="ComboManufacturer" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5"
                   DisplayMemberPath="НаименованиеПроизводителя" SelectedValuePath="ИдПроизводителя"/>
        <Label Content="Поставщик:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Name="ComboSupplier" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5"
                    DisplayMemberPath="НаименованиеПоставщика" SelectedValuePath="ИдПоставщика"/>
        <Label Content="Цена:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>   
        <TextBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5"/>
        <Label Content="Количество на складе:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5"/>

        <StackPanel  Orientation="Horizontal" Margin="30" Grid.Row="7" Grid.Column="0">
            <Button Content="Сохранить" Width="85" Height="25" Margin="0,0,10,0" Click="ButtonSave_Click"/>
            <Button Content="Отмена" Width="85" Height="25" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
